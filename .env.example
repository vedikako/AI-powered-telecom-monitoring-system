POSTGRES_USER=telecom
POSTGRES_PASSWORD=telecom
POSTGRES_DB=telecom
POSTGRES_PORT=5432

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_METRICS_TOPIC=network.metrics
KAFKA_DLQ_TOPIC=network.metrics.dlq
KAFKA_CONSUMER_GROUP=metrics-processor

SIMULATOR_INTERVAL_SECONDS=10
BACKFILL_HOURS=6
INVALID_RATE=0.015

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

LOG_LEVEL=INFO
MODEL_VERSION=iforest_v1
MODEL_PATH=/app/models/iforest_v1.joblib
ML_MIN_TRAIN_ROWS=40000

ALERT_INTERVAL_SECONDS=20
ALERT_LOOKBACK_MINUTES=45
ALERT_COOLDOWN_MINUTES=15

# Leave empty to use the local mock sink (no ServiceNow account required).
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# Optional. Pipeline and API work with this false / empty.
LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
